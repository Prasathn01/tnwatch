# TNWatch — environment template. Copy to .env and fill in. NEVER commit .env.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key   # backend only, keep secret

# Gemini (complex reasoning / Tamil)
GEMINI_API_KEY=your-gemini-key

# Ollama (local on Mac Mini)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local staging DB
SQLITE_PATH=./data/staging.db

# Redis (optional locally)
REDIS_URL=redis://localhost:6379/0

# Monitoring (optional but recommended)
HEALTHCHECKS_URL=
SENTRY_DSN=

# Scraper etiquette
USER_AGENT=TNWatch/0.1 (civic data project; contact: you@example.com)
REQUEST_DELAY_SECONDS=3
